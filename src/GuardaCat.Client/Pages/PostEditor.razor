@page "/posts/new"
@page "/posts/{Id:guid}/edit"
@using System.Globalization
@using System.Text
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject PostsClient Posts
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>@(Id is null ? "Nova publicació" : "Edita la publicació") — Guarda.cat</PageTitle>
<section class="content-page">
    <header class="page-heading"><h1>@(Id is null ? "Nova publicació" : "Edita la publicació")</h1><a href="/my-posts">Les meves publicacions</a></header>
    @if (error is not null) { <div role="alert"><MudAlert Severity="Severity.Error">@error</MudAlert></div> }
    @if (loading) { <p role="status">Carregant…</p> }
    else if (ready)
    {
        <div class="editor-panel">
            <EditForm Model="model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudTextField T="string" Label="Títol" @bind-Value="model.Title" For="@(() => model.Title)" Disabled="busy" />
                <div class="post-body-editor">
                    <MudTextField T="string" Label="En què estàs pensant?" @bind-Value="model.BodyMarkdown" For="@(() => model.BodyMarkdown)"
                                  Lines="14" Disabled="busy" HelperText="Pots utilitzar títols, llistes, enllaços i codi." />
                    @if (Id is null)
                    {
                        <div class="post-image-toolbar" aria-label="Afegeix una imatge">
                            <span class="post-image-toolbar-label">Imatge</span>
                            <button type="button" class="post-image-tool" disabled="@busy" @onclick="OpenImageUrlDialogAsync"
                                    aria-label="Afegeix una imatge des d'un enllaç" title="Imatge des d'un enllaç">
                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Small" />
                                <span>Enllaç</span>
                            </button>
                            <label class="post-image-tool @(busy ? "is-disabled" : null)" for="post-image-upload"
                                   aria-label="Puja una imatge des del dispositiu" title="Puja una imatge">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                <span>Puja</span>
                            </label>
                            <InputFile id="post-image-upload" class="post-image-input" OnChange="SelectImageAsync"
                                       accept="image/jpeg,image/png" disabled="@busy" />
                        </div>
                        @if (ImagePreviewSource is not null)
                        {
                            <figure class="post-image-preview">
                                <img src="@ImagePreviewSource" alt="Vista prèvia de la imatge de la publicació" />
                                <figcaption>
                                    <span>@(imageSource == "file" ? selectedImage?.Name : "Imatge des d'un enllaç")</span>
                                    <button type="button" @onclick="RemoveImage" disabled="@busy">Retira</button>
                                </figcaption>
                            </figure>
                        }
                    }
                </div>
                <div class="tag-editor">
                    <label for="post-tags">Etiquetes</label>
                    <div class="tag-editor-input-row @(tagError is null ? null : "has-error")">
                        <input @ref="tagInput" id="post-tags" class="tag-editor-input" value="@tagDraft"
                               @oninput="OnTagInput" disabled="@TagInputDisabled"
                               placeholder="@(editingTagIndex is null ? "Escriu una etiqueta i prem coma" : "Edita l'etiqueta")"
                               aria-describedby="tag-editor-help @(tagError is null ? null : "tag-editor-error")"
                               aria-invalid="@(tagError is not null)" />
                        <button type="button" class="tag-editor-confirm" @onclick="CommitTagDraft"
                                disabled="@(TagInputDisabled || string.IsNullOrWhiteSpace(tagDraft))"
                                aria-label="@(editingTagIndex is null ? "Afegeix l'etiqueta" : "Confirma els canvis")"
                                title="@(editingTagIndex is null ? "Afegeix" : "Confirma")">
                            <MudIcon Icon="@(editingTagIndex is null ? Icons.Material.Filled.Add : Icons.Material.Filled.Check)" Size="Size.Small" />
                        </button>
                        @if (editingTagIndex is not null)
                        {
                            <button type="button" class="tag-editor-cancel" @onclick="CancelTagEdit" disabled="@busy"
                                    aria-label="Cancel·la l'edició" title="Cancel·la">
                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                            </button>
                        }
                    </div>
                    @if (tags.Count > 0)
                    {
                        <div class="tag-editor-list" aria-label="Etiquetes afegides">
                            @for (var index = 0; index < tags.Count; index++)
                            {
                                var tagIndex = index;
                                var tag = tags[index];
                                <span @key="tag" class="tag-editor-chip @(editingTagIndex == tagIndex ? "is-editing" : null)">
                                    <button type="button" class="tag-editor-chip-label" @onclick="() => EditTag(tagIndex)"
                                            disabled="@busy" aria-label="Edita l'etiqueta @tag" title="Edita">
                                        #@tag
                                    </button>
                                    <button type="button" class="tag-editor-chip-remove" @onclick="() => RemoveTag(tagIndex)"
                                            disabled="@busy" aria-label="Elimina l'etiqueta @tag" title="Elimina">
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                    </button>
                                </span>
                            }
                        </div>
                    }
                    <div class="tag-editor-meta">
                        <span id="tag-editor-help">Fins a 5. Lletres, números, espais o guions.</span>
                        <span aria-label="@tags.Count de 5 etiquetes">@tags.Count/5</span>
                    </div>
                    @if (tagError is not null)
                    {
                        <p id="tag-editor-error" class="tag-editor-error" role="alert">@tagError</p>
                    }
                </div>
                <div class="page-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy">@(Id is null ? "Publica" : "Desa els canvis")</MudButton>
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" OnClick="PreviewAsync" Disabled="busy">Vista prèvia</MudButton>
                    <a href="@(Id is null ? "/" : $"/posts/{Id}")">Cancel·la</a>
                </div>
                <p class="post-meta">En desar, el contingut es publica per a tothom. No es guarden esborranys.</p>
            </EditForm>
        </div>
        @if (Id is { } postId) { <a href="@($"/posts/{postId}")">Veure la publicació</a> }
        @if (preview is not null)
        {
            <section class="article-panel" aria-label="Vista prèvia"><h2>Vista prèvia</h2><p class="post-meta">Contingut de l'última previsualització.</p><div class="markdown-body">@((MarkupString)preview)</div></section>
        }
    }
    else { <a href="/my-posts">Torna a les teves publicacions</a> }
</section>

@code {
    [Parameter] public Guid? Id { get; set; }
    private SavePostRequest model = new();
    private CancellationTokenSource cancellation = new();
    private string? error;
    private string? preview;
    private List<string> tags = [];
    private string tagDraft = string.Empty;
    private string? tagError;
    private int? editingTagIndex;
    private ElementReference tagInput;
    private bool focusTagInput;
    private string imageSource = "none";
    private string imageUrl = string.Empty;
    private string? localImagePreview;
    private IBrowserFile? selectedImage;
    private bool loading, ready, busy;
    private bool TagInputDisabled => busy || (tags.Count >= 5 && editingTagIndex is null);
    private string? ImagePreviewSource => imageSource == "file" ? localImagePreview
        : imageSource == "url" && imageUrl.Length > 0 ? imageUrl : null;

    protected override async Task OnParametersSetAsync()
    {
        cancellation.Cancel(); cancellation.Dispose(); cancellation = new();
        var ct = cancellation.Token;
        model = new(); tags = []; tagDraft = string.Empty; tagError = null; editingTagIndex = null;
        imageSource = "none"; imageUrl = string.Empty;
        localImagePreview = null; selectedImage = null; preview = null; error = null; ready = false; loading = true;
        if (Id is { } id)
        {
            var result = await Posts.EditAsync(id, ct);
            if (ct.IsCancellationRequested) return;
            error = result.Error;
            if (result.Value is { } post)
            {
                tags = [.. post.Tags];
                model = new() { Title = post.Title, BodyMarkdown = post.BodyMarkdown, Tags = [.. tags] };
                ready = true;
            }
        }
        else ready = true;
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusTagInput) return;
        focusTagInput = false;
        await tagInput.FocusAsync();
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        if (!string.IsNullOrWhiteSpace(tagDraft) && !TryCommitTag(tagDraft)) return;
        busy = true;
        var ct = cancellation.Token;
        try
        {
            model.Tags = [.. tags];
            model.ImageUrl = Id is null && imageSource == "url" ? imageUrl : null;
            ApiResult<PostResponse> result;
            if (Id is null && imageSource == "url" && string.IsNullOrWhiteSpace(imageUrl))
            {
                error = "Indica l'enllaç de la imatge abans de publicar.";
                return;
            }
            if (Id is null && imageSource == "file")
            {
                if (selectedImage is null)
                {
                    error = "Selecciona una imatge abans de publicar.";
                    return;
                }
                result = await Posts.SaveWithImageAsync(model, selectedImage, ct);
            }
            else result = await Posts.SaveAsync(Id, model, ct);
            if (ct.IsCancellationRequested) return;
            error = result.Error;
            if (result.Value is { } post) Navigation.NavigateTo($"/posts/{post.Id}");
        }
        finally { busy = false; }
    }

    private void OnTagInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        tagError = null;
        if (!value.Contains(','))
        {
            tagDraft = value;
            return;
        }

        var parts = value.Split(',');
        tagDraft = parts[^1];
        for (var index = 0; index < parts.Length - 1; index++)
        {
            if (string.IsNullOrWhiteSpace(parts[index])) continue;
            if (TryCommitTag(parts[index])) continue;

            tagDraft = string.Join(", ", parts[index..]);
            return;
        }
    }

    private void CommitTagDraft()
    {
        if (!string.IsNullOrWhiteSpace(tagDraft)) TryCommitTag(tagDraft);
    }

    private bool TryCommitTag(string value)
    {
        if (!TryNormalizeTag(value, out var normalized))
        {
            tagError = "Cada etiqueta ha de tenir entre 2 i 30 caràcters i només pot contenir lletres, números, espais o guions.";
            return false;
        }

        var duplicateIndex = tags.FindIndex(tag => string.Equals(tag, normalized, StringComparison.Ordinal));
        if (duplicateIndex >= 0 && duplicateIndex != editingTagIndex)
        {
            tagError = "Aquesta etiqueta ja està afegida.";
            return false;
        }

        if (editingTagIndex is { } index)
        {
            tags[index] = normalized;
            editingTagIndex = null;
        }
        else
        {
            if (tags.Count >= 5)
            {
                tagError = "Pots indicar un màxim de 5 etiquetes.";
                return false;
            }
            tags.Add(normalized);
        }

        tagDraft = string.Empty;
        tagError = null;
        model.Tags = [.. tags];
        return true;
    }

    private void EditTag(int index)
    {
        if (editingTagIndex == index)
        {
            focusTagInput = true;
            return;
        }
        if (!string.IsNullOrWhiteSpace(tagDraft) && !TryCommitTag(tagDraft)) return;

        editingTagIndex = index;
        tagDraft = tags[index];
        tagError = null;
        focusTagInput = true;
    }

    private void CancelTagEdit()
    {
        editingTagIndex = null;
        tagDraft = string.Empty;
        tagError = null;
    }

    private void RemoveTag(int index)
    {
        tags.RemoveAt(index);
        if (editingTagIndex == index) CancelTagEdit();
        else if (editingTagIndex > index) editingTagIndex--;
        tagError = null;
        model.Tags = [.. tags];
    }

    private static bool TryNormalizeTag(string value, out string tag)
    {
        var source = value.Normalize(NormalizationForm.FormKC).Trim().TrimStart('#');
        var result = new StringBuilder(source.Length);
        var pendingSeparator = false;
        foreach (var character in source)
        {
            if (char.IsLetterOrDigit(character))
            {
                if (pendingSeparator && result.Length > 0) result.Append('-');
                result.Append(char.ToLower(character, CultureInfo.InvariantCulture));
                pendingSeparator = false;
            }
            else if (char.IsWhiteSpace(character) || character == '-') pendingSeparator = result.Length > 0;
            else
            {
                tag = string.Empty;
                return false;
            }
        }

        tag = result.ToString();
        return tag.Length is >= 2 and <= 30;
    }

    private async Task PreviewAsync()
    {
        if (busy) return;
        busy = true;
        var ct = cancellation.Token;
        try
        {
            var result = await Posts.PreviewAsync(model.BodyMarkdown, ct, Id,
                Id is null && imageSource == "url" ? imageUrl : null);
            if (ct.IsCancellationRequested) return;
            error = result.Error; preview = result.Value?.BodyHtml;
        }
        finally { busy = false; }
    }

    private async Task OpenImageUrlDialogAsync()
    {
        var parameters = new DialogParameters<ImageUrlDialog>();
        parameters.Add(dialog => dialog.InitialUrl, imageSource == "url" ? imageUrl : string.Empty);
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ImageUrlDialog>("Imatge des d'un enllaç", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string url) return;

        imageSource = "url";
        imageUrl = url;
        selectedImage = null;
        localImagePreview = null;
        preview = null;
        error = null;
    }

    private async Task SelectImageAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > MediaLimits.MaxBytes)
        {
            error = "La imatge supera els 5 MiB.";
            return;
        }
        if (file.ContentType is not ("image/jpeg" or "image/png"))
        {
            error = "Tria una imatge JPEG o PNG.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MediaLimits.MaxBytes, cancellation.Token);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, cancellation.Token);
            localImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            selectedImage = file;
            imageSource = "file";
            imageUrl = string.Empty;
            preview = null;
            error = null;
        }
        catch (Exception exception) when (exception is IOException or OperationCanceledException)
        {
            if (!cancellation.IsCancellationRequested)
                error = "No s'ha pogut llegir la imatge. Torna-la a seleccionar.";
        }
    }

    private void RemoveImage()
    {
        imageSource = "none";
        imageUrl = string.Empty;
        localImagePreview = null;
        selectedImage = null;
        preview = null;
        error = null;
    }

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}
