@page "/404"

<PageTitle>Página no encontrada — Guarda.cat</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="not-found">
    <MudText Typo="Typo.overline">ERROR 404</MudText>
    <MudText HtmlTag="h1" Typo="Typo.h2">Esta página no está guardada.</MudText>
    <MudText Typo="Typo.body1">Puede que el enlace haya cambiado o todavía no exista.</MudText>
    <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
        Volver al inicio
    </MudButton>
</MudContainer>
