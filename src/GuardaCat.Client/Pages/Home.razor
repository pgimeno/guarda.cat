@page "/"

<PageTitle>Publicacions — Guarda.cat</PageTitle>

<div class="community-workspace">
    <aside class="left-rail" aria-label="Seccions de Guarda.cat">
        <nav class="rail-nav">
            <a href="/#feed-title" class="rail-link is-active" aria-current="page">
                <span class="rail-symbol" aria-hidden="true">G</span>
                Portada
            </a>
            <a href="/#temes" class="rail-link">
                <span class="rail-symbol" aria-hidden="true">#</span>
                Temes
            </a>
            <a href="/#comunitat" class="rail-link">
                <span class="rail-symbol" aria-hidden="true">+</span>
                Comunitat
            </a>
        </nav>

        <div class="rail-context">
            <p class="rail-label">Guarda.cat</p>
            <p>Converses en català sobre el que passa aquí i arreu.</p>
        </div>
    </aside>

    <section class="feed-column" aria-labelledby="feed-title">
        <header class="feed-heading">
            <div>
                <p class="eyebrow">PORTADA</p>
                <h1 id="feed-title">Publicacions</h1>
            </div>
            <p class="feed-intro">Actualitat, preguntes i descobertes compartides per la comunitat.</p>
        </header>

        <AuthorizeView>
            <div class="page-actions">
                <a class="primary-action" href="/posts/new">Nova publicació</a>
                <a href="/my-posts">Les meves publicacions</a>
            </div>
        </AuthorizeView>
        <PostFeed Page="@(Page ?? 1)" />
    </section>

    <aside class="right-rail" aria-label="Informació de la comunitat">
        <section id="comunitat" class="community-panel anchor-section" aria-labelledby="community-title" tabindex="-1">
            <div class="community-panel-header">
                <span class="community-monogram" aria-hidden="true">G</span>
                <span>Comunitat</span>
            </div>
            <div class="community-panel-body">
                <h2 id="community-title">Guarda.cat</h2>
                <p>Un espai generalista en català per entendre Catalunya, mirar el món i compartir perspectives.</p>
                <dl class="community-facts">
                    <div>
                        <dt>Accés</dt>
                        <dd>Lectura pública</dd>
                    </div>
                    <div>
                        <dt>Àmbit</dt>
                        <dd>Catalunya i el món</dd>
                    </div>
                </dl>
            </div>
        </section>

        <section id="temes" class="topics-panel anchor-section" aria-labelledby="topics-title" tabindex="-1">
            <div class="panel-heading">
                <h2 id="topics-title">Temes</h2>
                <span>Per explorar</span>
            </div>
            <div class="topic-list" role="list">
                @foreach (var topic in Topics)
                {
                    <div @key="topic.Name" class="topic-row" role="listitem">
                        <span class="topic-mark" aria-hidden="true">#</span>
                        <div>
                            <strong>@topic.Name</strong>
                            <span>@topic.Description</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <footer class="community-footer">Guarda.cat · Fet per conversar</footer>
    </aside>
</div>

@code {
    [SupplyParameterFromQuery] public int? Page { get; set; }

    private static readonly (string Name, string Description)[] Topics =
    [
        ("Actualitat", "Catalunya i el que passa al món"),
        ("Cultura", "Llibres, cinema, música i arts"),
        ("Ciència", "Idees i descobertes"),
        ("Esports", "Competició, equips i afició"),
        ("Viatges", "Llocs, rutes i experiències"),
        ("Vida", "Consells, preguntes i vivències")
    ];
}
