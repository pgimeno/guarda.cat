@page "/"
@implements IDisposable
@inject PostsClient Posts

<PageTitle>Publicacions — Guarda.cat</PageTitle>

<div class="community-workspace">
    <aside class="left-rail" aria-label="Seccions de Guarda.cat">
        <nav class="rail-nav">
            <a href="/#feed-title" class="rail-link is-active" aria-current="page">
                <span class="rail-symbol" aria-hidden="true">G</span>
                Portada
            </a>
            <a href="/#temes" class="rail-link">
                <span class="rail-symbol" aria-hidden="true">#</span>
                Temes
            </a>
        </nav>

        <div class="rail-context">
            <p class="rail-label">Guarda.cat</p>
            <p>Converses en català sobre el que passa aquí i arreu.</p>
        </div>
    </aside>

    <section class="feed-column" aria-labelledby="feed-title">
        <header class="feed-heading">
            <div>
                <p class="eyebrow">PORTADA</p>
                <h1 id="feed-title">Publicacions</h1>
            </div>
            <p class="feed-intro">Actualitat, preguntes i descobertes compartides per la comunitat.</p>
        </header>

        <AuthorizeView>
            <div class="page-actions">
                <a class="primary-action" href="/posts/new"><span aria-hidden="true">+</span> Nova publicació</a>
                <a href="/my-posts">Les meves publicacions</a>
            </div>
        </AuthorizeView>
        @if (!string.IsNullOrWhiteSpace(Tag))
        {
            <p class="active-filter">Filtrant per <strong>#@Tag</strong> · <a href="/">Neteja el filtre</a></p>
        }
        <PostFeed Page="@(Page ?? 1)" Tag="@Tag" />
    </section>

    <aside class="right-rail" aria-label="Temes de Guarda.cat">
        <section id="temes" class="topics-panel anchor-section" aria-labelledby="topics-title" tabindex="-1">
            <div class="panel-heading">
                <h2 id="topics-title">Temes</h2>
                <span>Per explorar</span>
            </div>
            @if (topicsLoading)
            {
                <p class="topic-status" role="status">Carregant temes…</p>
            }
            else if (topicsError is not null)
            {
                <div class="topic-status" role="alert">
                    <p>@topicsError</p>
                    <button class="secondary-action" @onclick="LoadTopicsAsync">Torna-ho a provar</button>
                </div>
            }
            else if (topics.Count == 0)
            {
                <p class="topic-status">Els temes apareixeran quan es publiqui la primera etiqueta.</p>
            }
            else
            {
                <div class="topic-list" role="list">
                @foreach (var topic in topics)
                {
                    <a @key="topic.Name" class="topic-row" role="listitem" href="@($"/?tag={Uri.EscapeDataString(topic.Name)}")">
                        <span class="topic-mark" aria-hidden="true">#</span>
                        <div>
                            <strong>@topic.Name</strong>
                            <span>@topic.PostCount @(topic.PostCount == 1 ? "resultat" : "resultats")</span>
                        </div>
                    </a>
                }
                </div>
            }
        </section>

        <footer class="community-footer">Guarda.cat · Fet per conversar</footer>
    </aside>
</div>

@code {
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Tag { get; set; }

    private readonly CancellationTokenSource topicsCancellation = new();
    private List<TopicResponse> topics = [];
    private string? topicsError;
    private bool topicsLoading = true;

    protected override Task OnInitializedAsync() => LoadTopicsAsync();

    private async Task LoadTopicsAsync()
    {
        topicsLoading = true;
        topicsError = null;
        var result = await Posts.TopicsAsync(topicsCancellation.Token);
        if (topicsCancellation.IsCancellationRequested) return;
        topics = result.Value ?? [];
        topicsError = result.Error;
        topicsLoading = false;
    }

    public void Dispose()
    {
        topicsCancellation.Cancel();
        topicsCancellation.Dispose();
    }
}
