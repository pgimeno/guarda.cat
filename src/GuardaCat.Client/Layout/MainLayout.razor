@inherits LayoutComponentBase
@using GuardaCat.Client.Theming

<MudThemeProvider Theme="@GuardaCatTheme.Default" IsDarkMode="false" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell">
    <a href="#main-content" class="skip-link">Vés al contingut</a>

    <header class="site-header">
        <div class="site-header-inner">
            <a href="/" class="brand" aria-label="Guarda.cat, inici">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 4.75h10a1.25 1.25 0 0 1 1.25 1.25v13.1l-6.25-3.45-6.25 3.45V6A1.25 1.25 0 0 1 7 4.75Z" />
                    </svg>
                </span>
                <span>Guarda<span class="brand-suffix">.cat</span></span>
            </a>

            <nav class="header-nav" aria-label="Navegació principal">
                <a href="/#feed-title" class="header-link is-active" aria-current="page">Inici</a>
                <a href="/#temes" class="header-link">Temes</a>
                <a href="/#comunitat" class="header-link">Comunitat</a>
            </nav>

            <div class="header-status" aria-label="Comunitat de lectura oberta">
                <span class="status-dot" aria-hidden="true"></span>
                Comunitat oberta
            </div>
        </div>
    </header>

    <main class="main-content" id="main-content" tabindex="-1">
        @Body
    </main>
</div>
