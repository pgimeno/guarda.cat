@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="site-header">
        <MudContainer MaxWidth="MaxWidth.Large" Class="header-inner">
            <MudLink Href="/" Underline="Underline.None" Class="brand" aria-label="Guarda.cat, inicio">
                Guarda<span>.cat</span>
            </MudLink>

            <MudSpacer />

            <nav class="desktop-nav" aria-label="Navegación principal">
                <MudLink Href="/" Underline="Underline.None" Class="nav-link">Inicio</MudLink>
                <MudText Typo="Typo.body2" Class="nav-muted">Explorar</MudText>
                <MudText Typo="Typo.body2" Class="nav-muted">Acceder</MudText>
            </nav>
        </MudContainer>
    </MudAppBar>

    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#183B32",
            Secondary = "#D97B4A",
            Background = "#F7F6F2",
            Surface = "#F7F6F2",
            AppbarBackground = "#F7F6F2",
            AppbarText = "#183B32",
            TextPrimary = "#18231F",
            TextSecondary = "#65706B",
            Divider = "#D9DDD8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "Segoe UI", "sans-serif"]
            },
            H1 = new H1Typography
            {
                FontFamily = ["Georgia", "Times New Roman", "serif"],
                FontSize = "clamp(3rem, 7vw, 6.5rem)",
                FontWeight = "500",
                LineHeight = "0.98",
                LetterSpacing = "-0.055em"
            },
            H2 = new H2Typography
            {
                FontFamily = ["Georgia", "Times New Roman", "serif"],
                FontWeight = "500",
                LetterSpacing = "-0.025em"
            }
        }
    };
}
