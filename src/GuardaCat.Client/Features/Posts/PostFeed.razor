@implements IDisposable
@inject PostsClient Posts

<section class="feed-frame" aria-label="Llista de publicacions">
    <div class="feed-toolbar">
        <span class="sort-tab is-active">@(string.IsNullOrWhiteSpace(Tag) ? "Més recents" : $"#{Tag}")</span>
        @if (data is not null) { <span class="feed-count">@data.TotalCount publicacions</span> }
    </div>
    @if (loading)
    {
        <div class="feed-loading" role="status" aria-label="Carregant publicacions">
            <span class="feed-loading-avatar" aria-hidden="true"></span>
            <span class="feed-loading-lines" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </div>
    }
    else if (error is not null)
    {
        <div class="feed-message" role="alert"><p>@error</p><button class="secondary-action" @onclick="LoadAsync">Torna-ho a provar</button></div>
    }
    else if (data is not null)
    {
        @if (data.Items.Count == 0)
        {
            <div class="empty-feed">
                <span class="empty-feed-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M6.5 5.5h11a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5H11l-4.5 3v-3A1.5 1.5 0 0 1 5 14V7a1.5 1.5 0 0 1 1.5-1.5Z" />
                        <path d="M8.5 9.5h7M8.5 12.5h4.5" />
                    </svg>
                </span>
                <h2>Encara no hi ha publicacions</h2>
                <p>La primera conversa que s'obri apareixerà aquí.</p>
            </div>
        }
        @foreach (var post in data.Items)
        {
            <article class="post-row" @key="post.Id">
                <a class="post-row-link" href="@($"/posts/{post.Id}")" aria-label="@($"Obre la publicació: {post.Title}")"></a>
                <p class="post-meta author-meta">
                    <a class="author-identity" href="@($"/users/{post.AuthorId}")">
                        <AuthorAvatar Name="@post.AuthorName" Avatar="post.AuthorAvatar" />
                        <span>@post.AuthorName</span>
                    </a>
                    <span aria-hidden="true">·</span>
                    <time datetime="@post.CreatedAtUtc.ToString("O")">@post.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                </p>
                <h2>@post.Title</h2>
                <p class="post-excerpt">@post.Excerpt</p>
                @if (post.ImageUrl is not null)
                {
                    <div class="post-feed-image">
                        <img src="@post.ImageUrl" alt="Imatge de la publicació @post.Title" loading="lazy" />
                    </div>
                }
                @if (post.Tags.Count > 0)
                {
                    <div class="tag-list" aria-label="Etiquetes">
                        @foreach (var tag in post.Tags)
                        {
                            <a @key="tag" class="tag-chip" href="@($"/?tag={Uri.EscapeDataString(tag)}")">#@tag</a>
                        }
                    </div>
                }
                <div class="post-stats">
                    <a class="post-metric" href="@($"/posts/{post.Id}#comments")">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M5.5 6.5h13a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5H11l-4.5 3v-3h-1A1.5 1.5 0 0 1 4 15V8a1.5 1.5 0 0 1 1.5-1.5Z" />
                        </svg>
                        <span>@post.CommentCount @(post.CommentCount == 1 ? "comentari" : "comentaris")</span>
                    </a>
                    <span class="post-metric">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 19.5S4.5 15.4 4.5 9.4A3.9 3.9 0 0 1 12 7.9a3.9 3.9 0 0 1 7.5 1.5c0 6-7.5 10.1-7.5 10.1Z" />
                        </svg>
                        <span>@post.LikeCount m'agrada</span>
                    </span>
                </div>
            </article>
        }
        <nav class="pagination" aria-label="Pàgines de publicacions">
            @if (Page > 1) { <a href="@PageHref(Page - 1)">← Anterior</a> }
            <span>Pàgina @Page</span>
            @if ((long)Page * data.PageSize < data.TotalCount) { <a href="@PageHref(Page + 1)">Següent →</a> }
        </nav>
    }
</section>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public bool Own { get; set; }
    [Parameter] public string? Tag { get; set; }
    [Parameter] public Guid? AuthorId { get; set; }
    private string BasePath => Own ? "/my-posts" : AuthorId is { } id ? $"/users/{id}" : "/";
    private string PageHref(int page) => string.IsNullOrWhiteSpace(Tag)
        ? $"{BasePath}?page={page}"
        : $"{BasePath}?page={page}&tag={Uri.EscapeDataString(Tag)}";
    private CancellationTokenSource? cancellation;
    private PagedResponse<PostSummaryResponse>? data;
    private string? error;
    private bool loading;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
        cancellation = new();
        var ct = cancellation.Token;
        loading = true;
        var result = await Posts.ListAsync(Page, Own, Tag, ct, AuthorId);
        if (ct.IsCancellationRequested) return;
        data = result.Value;
        error = result.Error;
        loading = false;
    }

    public void Dispose() { cancellation?.Cancel(); cancellation?.Dispose(); }
}
